# Supabase Edge Function runtime
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Coach
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Notification dispatcher
NOTIFICATION_DISPATCH_SECRET=

# RevenueCat webhook
# Secret API key is used only server-side to reconcile TRANSFER events.
REVENUECAT_SECRET_API_KEY=

# Configure RevenueCat to send the same Authorization header value.
REVENUECAT_WEBHOOK_AUTHORIZATION=

# Optional but recommended when webhook HMAC signing is enabled.
REVENUECAT_WEBHOOK_SIGNING_SECRET=
